# Copiar a .env.local y llenar con los datos de tu proyecto Supabase.
# Supabase → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# SECRETA: saltea las políticas de seguridad. Solo la usa el scraper,
# nunca llega al navegador. No la subas a git.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Cualquier cadena larga y aleatoria. Protege /api/cron.
# Generar con:  node -e "console.log(crypto.randomUUID())"
CRON_SECRET=
